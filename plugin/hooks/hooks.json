{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/traversiq\" plugin pre-edit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
